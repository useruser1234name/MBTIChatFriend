# OpenAI API Key (필수)
OPENAI_API_KEY=your-api-key-here

# 서버 설정
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql://mbti_app:change_me_in_production@localhost:5432/mbti_chat
POSTGRES_USER=mbti_app
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=mbti_chat

# Firebase (선택)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# CORS 허용 origin (쉼표 구분)
# development: 비워두면 * 전체 허용
# production: 반드시 명시적으로 설정 (예: https://yourdomain.com)
CORS_ORIGINS=

# 환경 (development / production)
ENVIRONMENT=development

# 인증 강제 여부 (production 기본: true, development 기본: false)
# REQUIRE_AUTH=true
