{
  "comment": "ECS Application Auto Scaling - Scheduled Actions for MBTIChatFriend",
  "service": "mbtichatfriend-api",
  "cluster": "mbtichatfriend",
  "scheduledActions": [
    {
      "scheduledActionName": "morning-peak-scale-out",
      "resourceId": "service/mbtichatfriend/mbtichatfriend-api",
      "scalableDimension": "ecs:service:DesiredCount",
