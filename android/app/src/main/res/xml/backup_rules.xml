<?xml version="1.0" encoding="utf-8"?>
<!--
  fullBackupContent rules (API 23-30 Auto Backup, also read by some API 31+ devices).
  On API 31+ this file is superseded by dataExtractionRules, but Android still parses it
  on older OS versions — so we keep both in sync.
-->
<full-backup-content>
    <!-- Room DB 본 파일 및 WAL/SHM 저널 -->
    <exclude domain="database" path="mbti_chat_db"/>
    <exclude domain="database" path="mbti_chat_db-shm"/>
    <exclude domain="database" path="mbti_chat_db-wal"/>
    <!-- DataStore Preferences (Firebase UID, 인증 토큰, 개인 설정) -->
    <exclude domain="file" path="datastore/user_prefs.preferences_pb"/>
</full-backup-content>
