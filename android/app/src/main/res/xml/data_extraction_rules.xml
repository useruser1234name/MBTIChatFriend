<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Room DB 파일 제외 (API 31+) -->
        <exclude domain="database" path="mbti_chat_db"/>
        <exclude domain="database" path="mbti_chat_db-shm"/>
        <exclude domain="database" path="mbti_chat_db-wal"/>
        <!-- DataStore 제외 -->
        <exclude domain="file" path="datastore/"/>
    </cloud-backup>
    <device-transfer>
        <!-- 기기 이전 시에도 DB 및 DataStore 제외 -->
        <exclude domain="database" path="mbti_chat_db"/>
        <exclude domain="database" path="mbti_chat_db-shm"/>
        <exclude domain="database" path="mbti_chat_db-wal"/>
        <exclude domain="file" path="datastore/"/>
    </device-transfer>
</data-extraction-rules>
